# Test help output is text
exec atlas --help
stdout 'USAGE:'
stdout 'atlas'
! stderr .

# Test version output is text
exec atlas --version
stdout '0.1.0'
! stderr .

# Test missing auth/site emits text error (pre-command errors use text format)
! exec atlas jira issue search --jql 'project=ABC'
! stdout .
stderr 'INVALID_ARGUMENT'
stderr 'jira.issue.search'

# Test output flag with jira issue get error (no site configured)
! exec atlas --output text jira issue get TEST-123
stderr 'INVALID_ARGUMENT'

# Test output flag with jsonl format
! exec atlas --output jsonl jira issue get TEST-123
stderr 'INVALID_ARGUMENT'

# Test toon output flag (should still work for errors)
! exec atlas --output toon jira issue get TEST-123
stderr 'INVALID_ARGUMENT'
